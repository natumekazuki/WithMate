{
  "name": "withmate",
  "version": "6.3.29-preview.1",
  "description": "キャラクターロールプレイ対応 coding agent デスクトップアプリ",
  "private": true,
  "main": "dist-electron/src-electron/main.js",
  "scripts": {
    "dev": "vite",
    "icon:generate": "node --import tsx scripts/build/generate-app-icon.ts",
    "stage:provider-binaries": "node --import tsx scripts/build/stage-provider-binaries.ts",
    "build:memory-cli": "tsx scripts/build/build-withmate-memory-cli.ts",
    "build:renderer": "vite build",
    "build:electron": "npm run build:memory-cli && tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "electron:dev": "npm run build:electron && tsx scripts/dev/run-electron-dev.ts",
    "electron:start": "npm run build && electron dist-electron/src-electron/main.js",
    "dist": "npm run icon:generate && npm run stage:provider-binaries && npm run build && electron-builder",
    "dist:win": "npm run icon:generate && npm run stage:provider-binaries && npm run build && electron-builder --win nsis",
    "dist:mac": "npm run icon:generate && npm run stage:provider-binaries && npm run build && electron-builder --mac dmg",
    "dist:dir": "npm run icon:generate && npm run stage:provider-binaries && npm run build && electron-builder --dir",
    "preview": "vite preview",
    "benchmark:data-loading": "tsx scripts/benchmarks/benchmark-data-loading.ts",
    "test": "node --import tsx scripts/checks/run-tests.ts",
    "test:shard": "node --import tsx scripts/checks/run-tests.ts",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && npm run typecheck:tests && npm run check:sqlite-owner-boundary && npm run check:dependency-boundaries",
    "check:dependency-boundaries": "tsx scripts/checks/check-dependency-boundaries.ts",
    "check:sqlite-owner-boundary": "tsx scripts/checks/check-sqlite-owner-boundary.ts",
    "affect:settlement-recovery": "tsx scripts/checks/character-affect-turn-settlement-recovery.ts",
    "validate:snapshot-ignore": "tsx scripts/checks/validate-snapshot-ignore.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@github/copilot-sdk": "^1.0.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.154.0",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tanstack/react-virtual": "^3.14.10",
    "ignore": "^7.0.8",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^12.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "prettier": "^3.9.6",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.natumekazuki.withmate",
    "productName": "WithMate",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.ico",
      "LICENSE",
      "package.json",
      "!node_modules/@openai/codex-win32-*/**",
      "!node_modules/@openai/codex-darwin-*/**",
      "!node_modules/@openai/codex-linux-*/**",
      "!node_modules/@github/copilot-win32-*/**",
      "!node_modules/@github/copilot-darwin-*/**",
      "!node_modules/@github/copilot-linux-*/**"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "build/provider-binaries",
        "to": "provider-binaries"
      }
    ],
    "extraFiles": [
      {
        "from": "build/cli/withmate-memory.cmd",
        "to": "withmate-memory.cmd"
      },
      {
        "from": "build/cli/withmate-glossary.cmd",
        "to": "withmate-glossary.cmd"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "shortcutName": "WithMate"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "identity": null
    }
  }
}
